# Postgres connection string used by the API.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/faber

# Surge auth server base URL (surge-server, remote SSO mode).
SURGE_URL=http://localhost:3000

# Service token used to authenticate this API to the Surge server.
SURGE_SERVICE_TOKEN=change-me

# Cookie domain used when clearing the surge_session cookie on logout.
SURGE_COOKIE_DOMAIN=.panit.dev

# API bind port.
API_PORT=3001

# Comma-separated list of allowed CORS origins.
CORS_ORIGIN=http://localhost:3000

# Snowflake IDs. Keep each deployed API instance unique.
SNOWFLAKE_MACHINE_ID=1
SNOWFLAKE_NODE_ID=1
