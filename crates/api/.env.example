# Postgres connection string used by the API.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/faber

# Surge auth server base URL (surge-server, remote SSO mode).
SURGE_URL=http://localhost:3000

# Service token used to authenticate this API to the Surge server.
SURGE_SERVICE_TOKEN=change-me

# Cookie domain used when clearing the surge_session cookie on logout.
SURGE_COOKIE_DOMAIN=.panit.dev

# Origin serving the auth UI. Only builds the CORS zone for the credential-entry
# routes under /api/surge — it issues no redirect of its own, since upstream
# surge-server answers GET /v1/login with the handoff to the auth UI.
SURGE_AUTH_UI_ORIGIN=http://localhost:3000

# Session lifetime advertised by the proxied perimeter. Match upstream's.
# SURGE_SESSION_TTL_SECS=259200

# API bind port.
API_PORT=3001

# Whether users may register hosts using the API process's local machine.
# Defaults to true. Set to false to reject new local hosts and switches to local transport.
# FABER_ALLOW_LOCAL_HOSTS=false

# Comma-separated Surge identity UUIDs allowed to operate faber's own hosts:
# registering a service host, setting its per-user limits, granting one user a
# ceiling of their own, and publishing service images. Everything under
# /api/admin checks this and nothing else does.
#
# Unset means nobody is an administrator, which is the direction a missing
# value should fail in. Keyed on the identity rather than the username, since
# a username can be changed and reassigned upstream. A value that is not a
# UUID stops the process at boot rather than reading as "not an administrator"
# on every request.
# FABER_ADMIN_IDENTITIES=8f1c6f1e-...,3b0d9a42-...

# Comma-separated list of browser origins serving the frontend. Allowed both on
# faber's own routes and on the /api/surge session routes (whoami, logout,
# factors) — leaving it unset blocks the frontend from reading its own session,
# which surfaces as a permanent signed-out state rather than as an error.
CORS_ORIGIN=http://localhost:3000

# This API's own externally reachable base URL — where a machine out on the
# internet dials to get here. Not the same as SURGE_URL (the auth server) or
# CORS_ORIGIN (browsers allowed to call in).
#
# Required only for agent-transport hosts: it is what the install one-liner
# tells a remote daemon to download from and connect back to. Leaving it unset
# makes POST /api/hosts/{id}/agent/enroll fail with a 503 naming this variable;
# every other route is unaffected. There is no default, because a guessed value
# produces an install command that fails on someone else's machine.
FABER_PUBLIC_URL=http://localhost:3001

# Where the agent daemon binaries served to enrolling hosts live, one file per
# architecture (faber-agent-x86_64). The API image sets this; a dev checkout
# defaults to target/release, where `cargo build --release -p faber-agent` puts
# a binary this API will serve for its own architecture.
# FABER_AGENT_BINARY_DIR=/usr/local/share/faber/agent

# Envelope encryption master key: 32 random bytes, base64-encoded.
# Generate: openssl rand -base64 32
# MUST be backed up separately from DB backups; loss makes all credentials permanently unreadable.
FABER_MASTER_KEY=change-me

# Web search. Unset all three and no run is granted the `search` tool.
# One SearXNG instance to search through; needs `search.formats: [json]` in its
# settings.yml. Takes precedence over the public network.
# SEARXNG_URL=https://searx.example.org
# Parallel hosted search. Takes precedence over the public network, but not a
# named SearXNG instance. Obtain a key from https://platform.parallel.ai.
# PARALLEL_API_KEY=change-me
# Search the public SearXNG instance network instead, discovered at boot from
# searx.space. Boot waits for discovery; a failure disables search, not the API.
# SEARCH_PUBLIC_NETWORK=true
# Proxy for search traffic only. Passed explicitly because the search client
# ignores the process's HTTP_PROXY/HTTPS_PROXY on purpose.
# SEARCH_PROXY=http://localhost:8080

# Snowflake IDs. Keep each deployed API instance unique.
SNOWFLAKE_MACHINE_ID=1
SNOWFLAKE_NODE_ID=1
