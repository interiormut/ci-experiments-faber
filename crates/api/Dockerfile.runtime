# syntax=docker/dockerfile:1

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /usr/sbin/nologin faber

WORKDIR /app

ENV API_PORT=3001
ENV FABER_AGENT_BINARY_DIR=/usr/local/share/faber/agent

COPY image-context/faber-api /usr/local/bin/faber-api
COPY image-context/faber-agent-x86_64 ${FABER_AGENT_BINARY_DIR}/faber-agent-x86_64

USER faber

EXPOSE 3001

CMD ["faber-api"]
