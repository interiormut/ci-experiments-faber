# syntax=docker/dockerfile:1

# Experiment: keep cargo-chef's compiled dependency output in a normal
# immutable BuildKit layer. Do not mount /app/target here; a source change must
# reuse the cacher layer and rebuild only the real application crate.
FROM rust:bookworm AS chef
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && cargo install cargo-chef --locked

FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY crates/api/Cargo.toml crates/api/Cargo.toml
COPY crates/environment/Cargo.toml crates/environment/Cargo.toml
COPY crates/faber-agent/Cargo.toml crates/faber-agent/Cargo.toml
COPY crates/harness/Cargo.toml crates/harness/Cargo.toml
COPY crates/llm/Cargo.toml crates/llm/Cargo.toml
COPY crates/readable/Cargo.toml crates/readable/Cargo.toml
COPY crates/search/Cargo.toml crates/search/Cargo.toml
COPY crates/traefik/Cargo.toml crates/traefik/Cargo.toml
RUN mkdir -p crates/api/src crates/environment/src crates/faber-agent/src \
    crates/harness/src crates/harness/examples crates/readable/src \
    crates/search/src crates/llm/src crates/traefik/src \
    && touch crates/api/src/main.rs \
             crates/environment/src/lib.rs \
             crates/faber-agent/src/main.rs \
             crates/harness/src/lib.rs \
             crates/harness/examples/run.rs \
             crates/readable/src/lib.rs \
             crates/search/src/lib.rs \
             crates/llm/src/lib.rs \
             crates/traefik/src/lib.rs \
    && cargo chef prepare --recipe-path recipe.json

FROM chef AS cacher
COPY --from=planner /app/recipe.json recipe.json
RUN --mount=type=cache,id=faber-chef-layer-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=faber-chef-layer-git,target=/usr/local/cargo/git,sharing=locked \
    cargo chef cook --release --locked -p api --recipe-path recipe.json

FROM cacher AS builder
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN --mount=type=cache,id=faber-chef-layer-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=faber-chef-layer-git,target=/usr/local/cargo/git,sharing=locked \
    cargo build --release --locked -p api \
    && mkdir -p /out \
    && cp target/release/api /out/faber-api

FROM debian:bookworm-slim AS runner
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /usr/sbin/nologin faber
WORKDIR /app
ENV API_PORT=3001
COPY --from=builder /out/faber-api /usr/local/bin/faber-api
USER faber
EXPOSE 3001
CMD ["/usr/local/bin/faber-api"]
